{
    "name": "sydgren/shipit-deployer",
    "description": "Trigger and monitor ShipIt deployments from Artisan — php artisan shipit:deploy.",
    "keywords": ["laravel", "deployment", "shipit", "ci", "artisan"],
    "homepage": "https://shipit.henriknordquist.dk",
    "license": "MIT",
    "authors": [
        {
            "name": "Henrik Nordquist"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "pestphp/pest": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Sydgren\\ShipIt\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sydgren\\ShipIt\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sydgren\\ShipIt\\ShipItServiceProvider"
            ],
            "aliases": {
                "ShipIt": "Sydgren\\ShipIt\\Facades\\ShipIt"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
